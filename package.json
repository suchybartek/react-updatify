{
  "name": "react-updatify",
  "version": "0.1.0",
  "description": "Zero-downtime \"Updating\" screen for React + Vite apps. Run `npm run build` on the server: the new version is built aside, files are swapped safely, and open tabs show a progress screen and reload themselves.",
  "keywords": ["react", "vite", "deploy", "update", "maintenance", "build", "overlay"],
  "license": "MIT",
  "author": "Bartlomiej Suchowirski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suchybartek/react-updatify.git"
  },
  "homepage": "https://suchowirski.life",
  "bugs": {
    "url": "https://github.com/suchybartek/react-updatify/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./vite": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "react-updatify": "bin/react-updatify.js"
  },
  "files": ["bin", "src", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "scripts": {
    "test": "node --test"
  }
}
